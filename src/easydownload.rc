#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)

// Application Icon
IDI_APP_ICON        ICON                    "..\\res\\easydownload.ico"

// Main Menu
IDR_MAIN_MENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새 다운로드(&N)...\tCtrl+N",         ID_TASK_NEW
        MENUITEM "비디오 다운로드(&V)...\tCtrl+V",     ID_TASK_NEW_VIDEO
        MENUITEM "일괄 링크 추출(&B)...\tCtrl+B",       ID_TASK_BATCH_EXTRACT
        MENUITEM SEPARATOR
        MENUITEM "종료(&X)",                         ID_APP_EXIT
    END
    POPUP "작업(&T)"
    BEGIN
        MENUITEM "시작 / 재시작(&S)\tEnter",         ID_TASK_START
        MENUITEM "다운로드 중단(&P)\tSpace",         ID_TASK_PAUSE
        MENUITEM "삭제(&D)\tDel",                    ID_TASK_DELETE
        MENUITEM SEPARATOR
        MENUITEM "저장 폴더 열기(&O)",               ID_TASK_OPEN_FOLDER
        MENUITEM "파일 실행(&R)",                   ID_TASK_OPEN_FILE
    END
    POPUP "도구(&T)"
    BEGIN
        MENUITEM "크롬 확장 프로그램 설치 / 연동(&C)", ID_EXTENSION_INSTALL
        MENUITEM "환경 설정(&S)...",                 ID_TASK_SETTINGS
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "EasyDownload 정보(&A)...",         ID_ABOUT
    END
END

// Tray Menu
IDR_TRAY_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "EasyDownload 열기",                ID_TRAY_SHOW
        MENUITEM SEPARATOR
        MENUITEM "새 다운로드...",                   ID_TASK_NEW
        MENUITEM "비디오 다운로드...",               ID_TASK_NEW_VIDEO
        MENUITEM SEPARATOR
        MENUITEM "환경 설정(&S)...",                 ID_TASK_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "프로그램 종료",                    ID_TRAY_EXIT
    END
END

// New Download Dialog
IDD_NEW_DOWNLOAD DIALOGEX 0, 0, 340, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "새 다운로드 추가"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "다운로드 URL:", IDC_LBL_URL, 14, 12, 60, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_URL, 14, 25, 312, 14, ES_AUTOHSCROLL
    
    LTEXT           "저장 파일 경로:", IDC_LBL_SAVETO, 14, 46, 60, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_SAVE_PATH, 14, 59, 248, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기(&B)...", IDC_BTN_BROWSE, 268, 59, 58, 14
    
    LTEXT           "분할 청크 수(1~12):", IDC_LBL_PARTS, 14, 82, 85, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_PARTS, 105, 80, 40, 14, ES_NUMBER | ES_CENTER
    CONTROL         "", IDC_SPN_PARTS, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 145, 80, 12, 14
    
    CONTROL         "다운로드 즉시 시작", IDC_CHK_START_IMMEDIATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 175, 82, 140, 12
    
    DEFPUSHBUTTON   "다운로드 시작(&D)", IDOK, 185, 120, 68, 16
    PUSHBUTTON      "취소", IDCANCEL, 258, 120, 68, 16
END

// Video Download Dialog
IDD_NEW_VIDEO DIALOGEX 0, 0, 360, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "비디오 / 스트림 다운로드"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "비디오 / M3U8 스트림 URL:", IDC_STATIC, 14, 10, 120, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_VIDEO_URL, 14, 22, 265, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "분석(&A)", IDC_BTN_ANALYZE, 285, 22, 60, 14
    
    LTEXT           "비디오 파일명:", IDC_STATIC, 14, 40, 100, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_VIDEO_TITLE, 14, 51, 331, 14, ES_AUTOHSCROLL

    LTEXT           "저장 위치:", IDC_STATIC, 14, 69, 100, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_VIDEO_SAVEPATH, 14, 80, 265, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기(&B)...", IDC_BTN_VIDEO_BROWSE, 285, 80, 60, 14
    
    LTEXT           "감지된 화질 및 해상도 선택:", IDC_STATIC, 14, 98, 150, 10, SS_LEFTNOWORDWRAP
    CONTROL         "", IDC_LST_STREAMS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 14, 110, 331, 70
    
    LTEXT           "대기 중...", IDC_LBL_VIDEO_STATUS, 14, 186, 200, 10, SS_LEFTNOWORDWRAP
    
    DEFPUSHBUTTON   "비디오 다운로드(&D)", IDOK, 205, 203, 75, 16
    PUSHBUTTON      "닫기", IDCANCEL, 285, 203, 60, 16
END

// Settings Dialog
IDD_SETTINGS DIALOGEX 0, 0, 340, 230
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyDownload 환경 설정"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB_SETTINGS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 8, 6, 324, 192

    // --- Tab 0: General & Startup ---
    GROUPBOX        "다운로드 기본 저장 경로", IDC_GRP_TAB0_1, 14, 28, 312, 42
    EDITTEXT        IDC_EDT_DEFAULT_DIR, 22, 44, 234, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "폴더 변경...", IDC_BTN_DIR_BROWSE, 260, 44, 60, 14
    
    GROUPBOX        "통합 및 자동 시작 옵션", IDC_GRP_TAB0_2, 14, 76, 312, 54
    CONTROL         "Windows 시작 시 자동 실행 (작업 스케줄러 등록)", IDC_CHK_AUTO_START, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 92, 220, 10
    CONTROL         "시스템 트레이로 최소화하여 시작", IDC_CHK_STARTUP_MINIMIZED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 110, 220, 10
    
    LTEXT           "* 기본 저장 폴더는 브라우저 다운로드 및 일반 파일 저장의 기본 위치로 사용됩니다.", IDC_LBL_TAB0_DESC, 18, 142, 304, 20

    // --- Tab 1: Category Rules ---
    GROUPBOX        "파일 형식별 전용 저장 폴더 및 확장자 지정", IDC_GRP_TAB1_1, 14, 28, 312, 158
    LTEXT           "카테고리:", IDC_LBL_TAB1_CAT, 22, 46, 45, 10, SS_LEFTNOWORDWRAP
    COMBOBOX        IDC_CMB_CATEGORY, 72, 44, 110, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    LTEXT           "대상 확장자:", IDC_LBL_TAB1_EXT, 22, 68, 45, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_CATEGORY_EXTS, 72, 66, 246, 14, ES_AUTOHSCROLL
    
    LTEXT           "지정 저장 폴더:", IDC_LBL_TAB1_DIR, 22, 90, 52, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_CATEGORY_DIR, 76, 88, 160, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "폴더 선택...", IDC_BTN_CATEGORY_BROWSE, 240, 88, 44, 14
    PUSHBUTTON      "초기화", IDC_BTN_CATEGORY_CLEAR, 288, 88, 30, 14
    
    LTEXT           "* 특정 확장자 파일을 다운로드할 때 해당 전용 폴더에 자동으로 분류 저장됩니다. 폴더를 비워두면 기본 다운로드 폴더에 저장됩니다. (확장자는 쉼표로 구분)", IDC_LBL_TAB1_DESC, 22, 118, 296, 36

    // --- Tab 2: Download Engine Settings ---
    GROUPBOX        "스마트 가속 분할 엔진 설정", IDC_GRP_TAB2_1, 14, 28, 312, 158
    LTEXT           "인터넷 회선 속도:", IDC_LBL_TAB2_SPEED, 22, 46, 90, 10, SS_LEFTNOWORDWRAP
    COMBOBOX        IDC_CMB_INTERNET_SPEED, 120, 44, 198, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "시작 연결 분할 수 (1~4):", IDC_LBL_TAB2_INIT, 22, 68, 95, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_INITIAL_PARTS, 120, 66, 40, 14, ES_NUMBER | ES_CENTER
    
    LTEXT           "최대 가속 분할 한도 (1~12):", IDC_LBL_TAB2_MAX, 175, 68, 95, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_MAX_PARTS, 278, 66, 40, 14, ES_NUMBER | ES_CENTER

    CONTROL         "회선 속도 도달 시 불필요한 연결 증설 억제 (스마트 가속)", IDC_CHK_ADAPTIVE_SPLIT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 92, 290, 10
    
    LTEXT           "* 연결(분할 청크)을 순차적으로 늘려 최종 다운로드 속도를 극대화합니다.\n* 설정한 회선 속도에 도달하여 이미 충분히 빠른 속도가 나오면, 불필요한 연결 증설을 멈추어 시스템 자원과 서버 부하를 절약합니다.", IDC_LBL_TAB2_DESC, 22, 118, 296, 42

    // --- Tab 3: Network & Security ---
    GROUPBOX        "DPI / SNI 차단 우회 엔진 (GoodbyeDPI)", IDC_GRP_TAB3_1, 14, 28, 312, 64
    CONTROL         "DPI 차단 우회 자동 실행 (기본 권장)", IDC_CHK_DPI_AUTO_START, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 44, 150, 10
    LTEXT           "우회 모드:", IDC_LBL_TAB3_MODE, 174, 44, 38, 10, SS_LEFTNOWORDWRAP
    COMBOBOX        IDC_CMB_DPI_MODE, 214, 42, 104, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "* 국내 통신사 SNI 차단 및 UDP 53 DNS 변조를 커널 패킷 역순 분할 및 비표준 안전 DNS로 완전 우회합니다.", IDC_LBL_TAB3_DESC1, 22, 62, 296, 20

    GROUPBOX        "Chrome 보안 DNS (DNS-over-HTTPS / Cloudflare 1.1.1.1)", IDC_GRP_TAB3_2, 14, 96, 312, 90
    LTEXT           "상태: 확인 중...", IDC_LBL_CHROME_DOH_STATUS, 22, 112, 190, 10, SS_LEFTNOWORDWRAP
    PUSHBUTTON      "보안 DNS 적용", IDC_BTN_CHROME_DOH_TOGGLE, 214, 110, 104, 14
    LTEXT           "* 통신사 DNS 하이재킹을 암호화(DoH) 우회하여 웹사이트 접속 지연 및 새로고침 문제를 해결합니다.\n* 적용 후 Chrome 브라우저를 재시작하면 즉시 활성화됩니다.", IDC_LBL_TAB3_DESC2, 22, 134, 296, 36

    // Dialog Buttons
    DEFPUSHBUTTON   "확인", IDOK, 205, 206, 58, 16
    PUSHBUTTON      "취소", IDCANCEL, 270, 206, 58, 16
END

// Download Progress Dialog
IDD_DOWNLOAD_PROGRESS DIALOGEX 0, 0, 380, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "EasyDownload - 파일 다운로드 진행"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "파일명:", IDC_STATIC, 12, 12, 35, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_PROG_FILENAME, 52, 12, 316, 10, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS
    
    LTEXT           "저장 위치:", IDC_STATIC, 12, 26, 35, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_PROG_SAVETO, 52, 26, 316, 10, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS

    LTEXT           "URL 출처:", IDC_STATIC, 12, 40, 35, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_PROG_URL, 52, 40, 316, 10, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS
    
    CONTROL         "", IDC_PRG_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 12, 56, 356, 14
    CONTROL         "", IDC_SEGMENT_CONTAINER, "Static", SS_NOTIFY | NOT WS_VISIBLE, 12, 74, 356, 26
    
    LTEXT           "상태: 연결 중...", IDC_LBL_PROG_STATUS, 12, 106, 180, 10, SS_LEFTNOWORDWRAP
    LTEXT           "분할 연결: 연결 중", IDC_LBL_PROG_PARTS, 200, 106, 168, 10, SS_RIGHT
    
    LTEXT           "크기: 0 B", IDC_LBL_PROG_SIZE, 12, 120, 180, 10, SS_LEFTNOWORDWRAP
    LTEXT           "속도: 0 KB/s", IDC_LBL_PROG_SPEED, 200, 120, 168, 10, SS_RIGHT
    
    LTEXT           "남은 시간: 계산 중...", IDC_LBL_PROG_TIME, 12, 134, 180, 10, SS_LEFTNOWORDWRAP
    
    CONTROL         "다운로드 완료 시 창 자동으로 닫기", IDC_CHK_CLOSE_WHEN_DONE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 154, 200, 10
    
    PUSHBUTTON      "파일 열기", IDC_BTN_PROG_OPEN_FILE, 12, 178, 64, 16
    PUSHBUTTON      "폴더 열기", IDC_BTN_PROG_OPEN_FOLDER, 80, 178, 64, 16
    
    PUSHBUTTON      "중단", IDC_BTN_PROG_PAUSE, 246, 178, 58, 16
    DEFPUSHBUTTON   "닫기", IDC_BTN_PROG_CANCEL, 308, 178, 60, 16
END

// Download Info Dialog (Completed Task Properties)
IDD_DOWNLOAD_INFO DIALOGEX 0, 0, 360, 215
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "다운로드 파일 상세 정보"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "파일 일반 정보", IDC_STATIC, 12, 8, 336, 68
    LTEXT           "파일명:", IDC_STATIC, 20, 22, 45, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_LBL_INFO_FILENAME, 68, 20, 270, 13, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    
    LTEXT           "파일 크기:", IDC_STATIC, 20, 38, 45, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_INFO_FILESIZE, 68, 38, 270, 10, SS_LEFTNOWORDWRAP
    
    LTEXT           "다운로드 상태:", IDC_STATIC, 20, 54, 45, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_INFO_STATUS, 68, 54, 150, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_INFO_PARTS, 225, 54, 113, 10, SS_RIGHT
    
    GROUPBOX        "저장 위치 및 원본 주소", IDC_STATIC, 12, 82, 336, 60
    LTEXT           "저장 위치:", IDC_STATIC, 20, 96, 45, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_INFO_SAVEPATH, 68, 94, 270, 14, ES_AUTOHSCROLL | ES_READONLY
    
    LTEXT           "출처 URL:", IDC_STATIC, 20, 118, 45, 10, SS_LEFTNOWORDWRAP
    EDITTEXT        IDC_EDT_INFO_URL, 68, 116, 212, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "주소 복사(&C)", IDC_BTN_INFO_COPY_URL, 284, 116, 54, 14
    
    LTEXT           "시작 일시:", IDC_STATIC, 14, 152, 40, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_INFO_CREATED, 56, 152, 120, 10, SS_LEFTNOWORDWRAP
    
    LTEXT           "완료 일시:", IDC_STATIC, 184, 152, 40, 10, SS_LEFTNOWORDWRAP
    LTEXT           "", IDC_LBL_INFO_COMPLETED, 226, 152, 120, 10, SS_LEFTNOWORDWRAP
    
    PUSHBUTTON      "파일 열기(&O)", IDC_BTN_INFO_OPEN_FILE, 12, 185, 64, 16
    PUSHBUTTON      "폴더 열기(&F)", IDC_BTN_INFO_OPEN_FOLDER, 80, 185, 64, 16
    
    DEFPUSHBUTTON   "닫기", IDCANCEL, 284, 185, 64, 16
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,5,2,0
PRODUCTVERSION  1,5,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "ai-open.kr"
            VALUE "FileDescription", "EasyDownload"
            VALUE "FileVersion", "1.5.2.0"
            VALUE "InternalName", "easydownload.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 ai-open.kr. All rights reserved."
            VALUE "OriginalFilename", "easydownload.exe"
            VALUE "ProductName", "EasyDownload"
            VALUE "ProductVersion", "1.5.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
